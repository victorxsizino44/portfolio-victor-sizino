# Server-only. Required for /api/agente-r. Expected format: HTTPS webhook URL. No default.
MAKE_AGENT_R_WEBHOOK_URL=

# Server-only. Optional. Agent R upstream timeout in milliseconds; range 1000-30000; default 10000.
MAKE_AGENT_R_TIMEOUT_MS=10000

# Server-only. Required for /api/contact. Expected format: HTTPS webhook URL. No default.
CONTACT_WEBHOOK_URL=

# Server-only. Optional. Contact upstream timeout in milliseconds; range 1000-30000; default 10000.
CONTACT_WEBHOOK_TIMEOUT_MS=10000

# Server-only. Required only by the currently unused Resend adapter in lib/email.ts. No default.
RESEND_API_KEY=

# Public. Optional. Scheduling page URL; the component has a current Cal.com fallback.
NEXT_PUBLIC_SCHEDULE_URL=
