# Server-only. Required for /api/agente-r. Expected format: HTTPS webhook URL. No default.
MAKE_AGENT_R_WEBHOOK_URL=

# Server-only. Optional. Agent R upstream timeout in milliseconds; range 1000-30000; default 10000.
MAKE_AGENT_R_TIMEOUT_MS=10000

# Server-only. Required for /api/contact. Expected format: HTTPS webhook URL. No default.
CONTACT_WEBHOOK_URL=

# Server-only. Optional. Contact upstream timeout in milliseconds; range 1000-30000; default 10000.
CONTACT_WEBHOOK_TIMEOUT_MS=10000

# Server-only. Required only by the currently unused Resend adapter in lib/email.ts. No default.
# Agent B MVP uses Supabase default SMTP + ConfirmationURL; no Resend key is required.
# Future custom SMTP credentials belong in Supabase's dashboard, never the browser.
RESEND_API_KEY=

# Public. Optional. Scheduling page URL; the component has a current Cal.com fallback.
NEXT_PUBLIC_SCHEDULE_URL=

# Agent B B02. Public project URL and publishable key only; consumed server-side.
# Both required when invoking the Supabase foundation. Never use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Optional B05 Gemini provider key; never expose to clients or commit a value.
GEMINI_API_KEY=

# Public PostHog project key/host for non-sensitive product events. Session Replay remains disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
